# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. This file (.env.example) IS committed so every
# teammate knows which variables the app expects.
# ---------------------------------------------------------------------------

# Firebase web config.
# NEXT_PUBLIC_ means "bundled into the browser JavaScript".
# That is correct and safe for Firebase: these identifiers are public by design.
# What actually protects your data is Firebase Security Rules (Sprint 2).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server-only keys. NO NEXT_PUBLIC_ PREFIX, EVER.
# Not used in Sprint 1. Added here now so nobody "helpfully" adds the prefix
# later. These are read only inside app/api/*/route.ts files (Sprint 4+).
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_API_KEY=
GEMINI_API_KEY=
